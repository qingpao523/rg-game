; 无尽入侵 - Endless Invasion
; Godot 4.7 2D Roguelite 生存割草游戏

config_version=5

[application]
config/name="无尽入侵"
config/description="Roguelite 生存割草游戏 - Endless Invasion"
config/version="0.1.0"
run/main_scene="res://assets/scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/art/app_icon.png"
boot_splash/bg_color=Color(0.086, 0.086, 0.094, 1)

[autoload]
GameApp="*res://assets/scripts/core/GameApp.gd"
EventBus="*res://assets/scripts/core/EventBus.gd"
TimeService="*res://assets/scripts/core/TimeService.gd"
GameSession="*res://assets/scripts/core/GameSession.gd"
ObjectPool="*res://assets/scripts/core/ObjectPool.gd"
PlatformAdapter="*res://assets/scripts/platform/PlatformAdapter.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]
2d/default_gravity=Vector2(0, 0)

[rendering]
renderer/rendering_method="forward_plus"
2d/snap/snap_2d_vertices_to_pixel_algorithm=1

[input]
move_up=[key_w,key_up]
move_down=[key_s,key_down]
move_left=[key_a,key_left]
move_right=[key_d,key_right]
active_skill=[key_space,mouse_button_left]
pause=[key_escape,key_p]
